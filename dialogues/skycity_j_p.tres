"type": "variable",
"value": "player_name"
} ],
"value_in_text": "{{player_name}}"
} ],
"text": "Kapasitas kapal dan penumpang sudah beres! Terima kasih atas solusimu, {{player_name}}!",
"translation_key": "Kapasitas kapal dan penumpang sudah beres! Terima kasih atas solusimu, {{player_name}}!",
"type": "dialogue"
},
"63": {
"next_id": "end",
"parent_id": "61",
"type": "goto"
},
"65": {
"character": "Ronnie",
"character_replacements": [  ],
"next_id": "66",
"replacements": [  ],
"text": "Apa yang harus aku lakukan ini…",
"translation_key": "Apa yang harus aku lakukan ini…",
"type": "dialogue"
},
"66": {
"character": "Ronnie",
"character_replacements": [  ],
"next_id": "67",
"replacements": [  ],
"text": "Oh kau yang disana, bisakah aku meminta bantuan",
"translation_key": "Oh kau yang disana, bisakah aku meminta bantuan",
"type": "dialogue"
},
"67": {
"character": "Player",
"character_replacements": [  ],
"next_id": "68",
"replacements": [  ],
"text": "Ah! Iya apa yang bisa aku bantu?",
"translation_key": "Ah! Iya apa yang bisa aku bantu?",
"type": "dialogue"
},
"68": {
"character": "Ronnie",
"character_replacements": [  ],
"next_id": "69",
"replacements": [  ],
"text": "Jadi gini, Baru saja ada seorang pengembara yang ingin ikut dalam perjalanan. Padahal kapasitas kapal hampir penuh dan semua persediaan sudah disiapkan.",
"translation_key": "Jadi gini, Baru saja ada seorang pengembara yang ingin ikut dalam perjalanan. Padahal kapasitas kapal hampir penuh dan semua persediaan sudah disiapkan.",
"type": "dialogue"
},
"69": {
"character": "Player",
"character_replacements": [  ],
"next_id": "70",
"replacements": [  ],
"text": "Hmm jadi mendadak begitu ya?",
"translation_key": "Hmm jadi mendadak begitu ya?",
"type": "dialogue"
},
"7": {
"character": "Player",
"character_replacements": [  ],
"next_id": "8",
"replacements": [  ],
"text": "Baiklah, akan ku lakukan",
"translation_key": "Baiklah, akan ku lakukan",
"type": "dialogue"
},
"70": {
"character": "Ronnie",
"character_replacements": [  ],
"next_id": "71",
"replacements": [  ],
"text": "Iya! Sekarang aku jadi bingung. Sebaiknya kita mempertahankan rencana yang sudah ada atau mencoba mencari cara lain?",
"translation_key": "Iya! Sekarang aku jadi bingung. Sebaiknya kita mempertahankan rencana yang sudah ada atau mencoba mencari cara lain?",
"type": "dialogue"
},
"71": {
"next_id": "72",
"next_id_after": "79",
"replacements": [  ],
"responses": PoolStringArray( "71", "75" ),
"text": "Mari cek kapasitas kapal dulu, jika tidak memungkinkan kita bisa melakukan rencana awal dan mencarikan jadwal keberangkatan berikutnya untuknya",
"translation_key": "Mari cek kapasitas kapal dulu, jika tidak memungkinkan kita bisa melakukan rencana awal dan mencarikan jadwal keberangkatan berikutnya untuknya",
"type": "response"
},
