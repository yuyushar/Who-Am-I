"character_replacements": [  ],
"next_id": "79",
"parent_id": "71",
"replacements": [  ],
"text": "Masuk akal! Kita memang harus memastikan kapasitas kapal tidak terlampaui. Aku akan memeriksa daftar persediaan dan mencarikan jadwal perjalanan selanjutnya jika diperlukan.",
"translation_key": "Masuk akal! Kita memang harus memastikan kapasitas kapal tidak terlampaui. Aku akan memeriksa daftar persediaan dan mencarikan jadwal perjalanan selanjutnya jika diperlukan.",
"type": "dialogue"
},
"75": {
"next_id": "76",
"next_id_after": "79",
"replacements": [  ],
"text": "Bagaimana kalau kita berbicara dengannya terlebih dahulu? Mungkin ada cara untuk menyesuaikan rencana agar dia tetap bisa ikut",
"translation_key": "Bagaimana kalau kita berbicara dengannya terlebih dahulu? Mungkin ada cara untuk menyesuaikan rencana agar dia tetap bisa ikut",
