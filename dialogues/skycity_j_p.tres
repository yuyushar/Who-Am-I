"replacements": [  ],
"text": "Hmm… Dengan pendapatmu kita bisa menyesuaikan perubahan angin yang tidak terduga, terimakasih sudah membantuku",
"translation_key": "Hmm… Dengan pendapatmu kita bisa menyesuaikan perubahan angin yang tidak terduga, terimakasih sudah membantuku",
"type": "dialogue"
},
"56": {
"character": "Guide",
"character_replacements": [  ],
"next_id": "57",
"replacements": [  ],
"text": "Merekapun menyelesaikan masalah angin tersebut, Semoga saja anginnya tidak berubah terlalu sering. Aku tidak mau kita berputar-putar di langit!",
"translation_key": "Merekapun menyelesaikan masalah angin tersebut, Semoga saja anginnya tidak berubah terlalu sering. Aku tidak mau kita berputar-putar di langit!",
"type": "dialogue"
},
