[resource]
script = ExtResource( 1 )
resource_version = 12
syntax_version = 2
raw_text = "~ start

Guide: Hey! Bangun!
Player: ugh... dimana aku?
Guide: Void... atau semacamnya, kau dipilih untuk meneliti berbagai dunia yang dibuat oleh [shake rate=20 level=10][redacted][/shake], detailnya tidak penting. Bangunlah kita harus bertemu dia.
Player: Siapa?
Guide: Gatekeeper dia akan membawamu ke tiap dunia nanti
Player: Lalu siapa kamu?
Guide: Pertanyaan yang benar adalah siapa dirimu sendiri?
do munculkan_input_nama()
=> END


~ ask_name

Guide: Okay, panggil aku Guide ajah
Gatekeeper: Sudah terbangun ternyata, aku gatekeeper
Player: Aku {{player_name}}
Gatekeeper: Nama yang bagus, baik sudah siap semua?
Guide: Siap!!!
Gatekeeper: Baiklah, tutup matamu dan percayakan dirimu padaku
do pindah_ke_zona()
=> END"
