"character_replacements": [  ],
"next_id": "56",
"parent_id": "52",
"replacements": [  ],
"text": "Resolusi: Kebutuhan mendesak warga diprioritaskan agar aktivitas vital masyarakat tidak terganggu.",
"translation_key": "Resolusi: Kebutuhan mendesak warga diprioritaskan agar aktivitas vital masyarakat tidak terganggu.",
"type": "dialogue"
},
"56": {
"character": "Guide",
"character_replacements": [  ],
"next_id": "57",
"replacements": [  ],
"text": "Mereka pun berhasil mengatasi krisis keterbatasan energi kota!",
