"90": {
"character": "Player",
"character_replacements": [  ],
"next_id": "91",
"replacements": [  ],
"text": "Woah! Kepalaku mulai pusing dengan semua gemerlap cahaya ini...",
"translation_key": "Woah! Kepalaku mulai pusing dengan semua gemerlap cahaya ini...",
"type": "dialogue"
},
"91": {
"character": "Guide",
"character_replacements": [  ],
"next_id": "92",
"replacements": [  ],
"text": "Iya nih, siapa sih yang punya ide membuat tempat yang begitu terang benderang begini?!",
"translation_key": "Iya nih, siapa sih yang punya ide membuat tempat yang begitu terang benderang begini?!",
"type": "dialogue"
},
"92": {
"character": "Gatekeeper",
"character_replacements": [  ],
"next_id": "93",
"replacements": [  ],
"text": "Dunia ini memang didesain untuk beraktivitas sepanjang hari tanpa pernah padam.",
"translation_key": "Dunia ini memang didesain untuk beraktivitas sepanjang hari tanpa pernah padam.",
"type": "dialogue"
},
"93": {
"character": "Guide",
"character_replacements": [  ],
"next_id": "94",
"replacements": [  ],
"text": "Jadi ga ada istirahatnya sama sekali? Sebaiknya kita cepat-cepat pergi dari sini yuk!",
"translation_key": "Jadi ga ada istirahatnya sama sekali? Sebaiknya kita cepat-cepat pergi dari sini yuk!",
"type": "dialogue"
},
"94": {
"character": "Player",
"character_replacements": [  ],
"next_id": "95",
"replacements": [  ],
"text": "Jadi kemana tujuan selanjutnya kita?",
"translation_key": "Jadi kemana tujuan selanjutnya kita?",
