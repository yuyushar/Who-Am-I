} ]
},
"next_id": "72",
"parent_id": "70",
"type": "mutation"
},
"72": {
"character": "Elio",
"character_replacements": [  ],
"next_id": "76",
"parent_id": "70",
"replacements": [  ],
"text": "Pendekatan yang baik. Menilai dengan kriteria yang konsisten, mutu visual, dan standar yang sistematis. Terima kasih.",
"translation_key": "Pendekatan yang baik. Menilai dengan kriteria yang konsisten, mutu visual, dan standar yang sistematis. Terima kasih.",
"type": "dialogue"
},
"73": {
"next_id": "74",
"next_id_after": "76",
"replacements": [  ],
"text": "Bagaimana kalau kita mendengarkan cerita dan latar belakang dari para senimannya terlebih dahulu?",
"translation_key": "Bagaimana kalau kita mendengarkan cerita dan latar belakang dari para senimannya terlebih dahulu?",
"type": "response"
},
