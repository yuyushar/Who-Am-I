"65": {
"character": "Elio",
"character_replacements": [  ],
"next_id": "66",
"replacements": [  ],
"text": "Hm... Tidak akan cukup ruang galeri ini...",
"translation_key": "Hm... Tidak akan cukup ruang galeri ini...",
"type": "dialogue"
},
"66": {
"character": "Player",
"character_replacements": [  ],
"next_id": "67",
"replacements": [  ],
"text": "Permisi, kalau boleh tahu ada kendala apa ya?",
"translation_key": "Permisi, kalau boleh tahu ada kendala apa ya?",
"type": "dialogue"
},
"67": {
"character": "Elio",
"character_replacements": [  ],
"next_id": "68",
"replacements": [  ],
"text": "Ah... saya adalah kurator pameran seni holografik ini. Terlalu banyak seniman hebat yang mengirimkan karya mereka, namun kapasitas ruangan kami tidak mencukupi.",
"translation_key": "Ah... saya adalah kurator pameran seni holografik ini. Terlalu banyak seniman hebat yang mengirimkan karya mereka, namun kapasitas ruangan kami tidak mencukupi.",
"type": "dialogue"
},
"68": {
"character": "Player",
"character_replacements": [  ],
"next_id": "69",
"replacements": [  ],
"text": "Hmm... berarti harus ada kurasi seleksi untuk karya yang akan dipamerkan ya?",
"translation_key": "Hmm... berarti harus ada kurasi seleksi untuk karya yang akan dipamerkan ya?",
"type": "dialogue"
},
"69": {
"character": "Elio",
"character_replacements": [  ],
"next_id": "70",
"replacements": [  ],
"text": "Tepat sekali. Setiap karya memiliki keunikan tersendiri, membuat saya sulit menentukan pilihan.",
"translation_key": "Tepat sekali. Setiap karya memiliki keunikan tersendiri, membuat saya sulit menentukan pilihan.",
"type": "dialogue"
},
"7": {
"character": "Player",
"character_replacements": [  ],
"next_id": "8",
"replacements": [  ],
"text": "Baiklah, aku akan membantu mereka yang sedang kesulitan!",
"translation_key": "Baiklah, aku akan membantu mereka yang sedang kesulitan!",
"type": "dialogue"
},
"70": {
"next_id": "71",
"next_id_after": "76",
"replacements": [  ],
"responses": PoolStringArray( "70", "73" ),
"text": "Bagaimana kalau kita menentukan beberapa kriteria terlebih dahulu, seperti kualitas visual, kesesuaian tema, dan teknik pembuatannya?",
"translation_key": "Bagaimana kalau kita menentukan beberapa kriteria terlebih dahulu, seperti kualitas visual, kesesuaian tema, dan teknik pembuatannya?",
"type": "response"
},
