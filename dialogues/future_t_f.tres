"value": "player_name"
} ],
"value_in_text": "{{player_name}}"
} ],
"text": "Terima kasih atas saranmu tempo hari, {{player_name}}. Pameran seni berjalan dengan sangat sukses.",
"translation_key": "Terima kasih atas saranmu tempo hari, {{player_name}}. Pameran seni berjalan dengan sangat sukses.",
