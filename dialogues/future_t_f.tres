},
"75": {
"character": "Elio",
"character_replacements": [  ],
"next_id": "76",
"parent_id": "73",
"replacements": [  ],
"text": "Pendekatan yang menyentuh. Menilai dari nilai personal, ekspresi emosional, dan kedalaman makna di balik setiap karya. Terima kasih.",
"translation_key": "Pendekatan yang menyentuh. Menilai dari nilai personal, ekspresi emosional, dan kedalaman makna di balik setiap karya. Terima kasih.",
"type": "dialogue"
},
